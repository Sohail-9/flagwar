# ========================================================
# DOLLAR WAR / FLAG WAR ENVIRONMENT CONFIGURATION
# ========================================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. Database: Postgres (Supabase) - Permanent Append-Only Ledger
# If left empty, Dollar War uses the robust local file ledger (.data/dollarwar-store.json)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 2. Live Scores: Upstash Redis Sorted Sets (ZINCRBY & ZREVRANGE)
# If left empty, Dollar War uses the in-memory sorted set engine with local persistence
UPSTASH_REDIS_REST_URL=https://[YOUR-ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=[YOUR-TOKEN]

# 3. Payments: Stripe Checkout (Global Cards & Wallets)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. Payments: Razorpay (India UPI & Cards)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# 5. Email Receipts & Notifications (Resend)
RESEND_API_KEY=re_...

# 6. Privacy Analytics (Plausible)
PLAUSIBLE_DOMAIN=dollarwar.com
